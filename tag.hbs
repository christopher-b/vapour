{{!< default}}

<div class="px-12 mb-6 w-3xl">
  <div>
    {{#tag}}
      <header>
        <h2 class="text-4xl">{{name}}</h2>

        {{#if feature_image}}
          <img class="my-3" src="{{feature_image}}" alt="{{name}}" />
        {{/if}}

        <p class="my-3">
          {{#if description}}
            {{description}}
          {{else}}
            {{plural ../pagination.total
                            empty=(t "A collection of 0 issues") singular=(t "A collection of 1 issue")
                            plural=(t "A collection of {numberOfIssues} issues" numberOfIssues=../pagination.total) }}
          {{/if}}
        </p>
      </header>
    {{/tag}}

    {{#foreach posts}}
      {{> "components/card"}}
    {{/foreach}}
  </div>
</div>